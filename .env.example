# Copy to .env and supply your own key. Never commit .env.
ANTHROPIC_API_KEY=

# Backend selection: anthropic (default) or bedrock. Restart the server to switch.
PROJECTCLARITY_PROVIDER=anthropic
# Optional model override. Blank uses the selected provider's default model.
PROJECTCLARITY_MODEL=
# Bedrock currently supports Amazon Nova Micro through Converse.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
# Explicit output contract; restart to change. tool_nullable is experimental.
PROJECTCLARITY_BEDROCK_OUTPUT=json_text

# Optional knowledge graph. Keep real values only in .env or the process environment.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
